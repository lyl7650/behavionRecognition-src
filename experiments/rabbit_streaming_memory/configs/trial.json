{
  "data_root": "dataset/rabbit/2026-10-22",
  "class_names": [
    "resting",
    "active",
    "eating",
    "drinking"
  ],
  "class_order_source": {
    "repo_config": "scripts/pipeline/pipeline_config.py SPECIES.rabbit",
    "confidence": "high",
    "evidence": "run_test.py and pipeline_config.py both define rabbit order as resting, active, eating, drinking"
  },
  "input": {
    "fps": 8,
    "imgsz": 224,
    "mean": [
      0.485,
      0.456,
      0.406
    ],
    "std": [
      0.229,
      0.224,
      0.225
    ]
  },
  "init_checkpoint": "outputs/rabbit/2026-10-20/repvit_best_distilled_2026-10-20_ema.pth",
  "backbone": "repvit_m1",
  "hidden_dim": 256,
  "block_seconds": 12,
  "burn_in_seconds": 5,
  "supervision": "all_but_burn_in",
  "epochs": 8,
  "batch_size": 1,
  "lr": 0.0003,
  "weight_decay": 0.05,
  "seeds": [
    42,
    43,
    44
  ],
  "val_max_videos_per_class": 12,
  "augment": {
    "fliplr": 0.5,
    "reverse": 0.0
  },
  "gates": {
    "reject_zero_byte_or_unreadable_videos": true,
    "require_strict_checkpoint_load": true,
    "require_class_order_confirmed": true
  },
  "training_modes": {
    "t0": {
      "sequence": "independent_window",
      "window_frames": 16,
      "loss": "window_endpoint"
    },
    "t1": {
      "sequence": "causal_stream_block",
      "loss": "uniform_after_burn_in"
    },
    "t2": {
      "sequence": "causal_stream_block",
      "loss": "last_step_after_burn_in"
    }
  },
  "block_seconds_t0": 2.0,
  "block_seconds_stream": 12.0,
  "burn_in_seconds_stream": 5.0
}
